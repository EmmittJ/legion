# Legion environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required — GitHub repo for vessels to clone and push branches to
REPO_URL=https://github.com/your-org/your-repo.git

# Required — GitHub token with Copilot access and repo read/write permissions
# Fine-grained PAT: needs "Contents" (read/write) and "Copilot Requests" permissions
GITHUB_TOKEN=ghp_your_token_here

# Optional — vessel image to use (default: legion/vessel-copilot:latest)
# Override with a ghcr.io SHA-pinned tag for production:
# VESSEL_IMAGE=ghcr.io/emmittj/legion/vessel-copilot:abc1234
VESSEL_IMAGE=

# Optional — model for the Copilot ACP session (default: gpt-5-mini)
# See: https://docs.github.com/en/copilot/reference/ai-models/supported-models
VESSEL_MODEL=

# Optional — seconds before Archon force-stops a vessel container (default: 3600)
ARCHON_TIMEOUT=

# Optional — seconds before vessel-driver times out waiting for Copilot (default: 2700)
VESSEL_TIMEOUT=
