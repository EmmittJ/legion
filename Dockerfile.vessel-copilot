# legion/vessel-copilot
# Vessel image: vessel-driver + bd CLI + GitHub Copilot CLI
#
# Build:
#   docker build -f Dockerfile.vessel-copilot -t legion/vessel-copilot:latest .
#
# The vessel-driver binary must be present in the build context:
#   vessel-driver  — built via: CGO_ENABLED=0 GOOS=linux go build ./cmd/vessel-driver
# The copilot binary is fetched at image build time from the official release URL.

FROM debian:bookworm-slim

# Install system dependencies in a single layer; clean apt lists to minimize image size
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        tar \
    && rm -rf /var/lib/apt/lists/*

# Beads CLI — baked in at build time (tarball release)
RUN set -eux; \
    BD_VER=$(curl -fsSL https://api.github.com/repos/steveyegge/beads/releases/latest \
        | grep '"tag_name"' | sed 's/.*"v\([^"]*\)".*/\1/'); \
    curl -fsSL "https://github.com/steveyegge/beads/releases/download/v${BD_VER}/beads_${BD_VER}_linux_amd64.tar.gz" \
        -o /tmp/beads.tar.gz \
    && tar -xzf /tmp/beads.tar.gz -C /tmp \
    && mv /tmp/bd /usr/local/bin/bd \
    && chmod +x /usr/local/bin/bd \
    && rm -f /tmp/beads.tar.gz /tmp/bd 2>/dev/null; true

# Copilot CLI — ACP server (copilot --acp --stdio)
# https://docs.github.com/en/copilot/reference/copilot-cli-reference/acp-server
RUN curl -fsSL https://github.com/github/copilot-cli/releases/latest/download/copilot-linux-amd64 \
    -o /usr/local/bin/copilot && chmod +x /usr/local/bin/copilot

# Vessel Driver — ACP client; reads ISSUE_ID, drives Copilot via JSON-RPC over stdio
COPY vessel-driver /usr/local/bin/vessel-driver
RUN chmod +x /usr/local/bin/vessel-driver

ENTRYPOINT ["/usr/local/bin/vessel-driver"]
