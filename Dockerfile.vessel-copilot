# legion/vessel-copilot
# Vessel image: vessel-driver + bd CLI + GitHub Copilot CLI
#
# Build:
#   docker build -f Dockerfile.vessel-copilot -t legion/vessel-copilot:latest .
#
# vessel-driver is compiled from source in the builder stage — no pre-built binary required.
# The copilot binary is fetched at image build time from the official release URL.

# ── Stage 1: compile vessel-driver ──────────────────────────────────────────
# go-acp requires Go ≥ 1.26.1; all dependencies are vendored so no network
# access is needed during the build.
FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -mod=vendor -o /vessel-driver ./cmd/vessel-driver/

# ── Stage 2: runtime image ───────────────────────────────────────────────────
FROM debian:bookworm-slim

# Install system dependencies in a single layer; clean apt lists to minimize image size
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        tar \
    && rm -rf /var/lib/apt/lists/*

# Beads CLI — baked in at build time (tarball release)
# Pinned to v0.60.0: BEADS_DOLT_SERVER_{HOST,PORT,USER} env vars are supported
# from v0.60.0 onwards, allowing vessel-driver to override config.yaml's server
# settings so bd points at the containerized Dolt (dolt:3306) instead of the
# host's 127.0.0.1:3307.  The "no common ancestor" dolt-pull warning exists in
# both 0.59.0 and 0.60.0 and is non-fatal; the pin to 0.59.0 was misdiagnosed.
RUN set -eux; \
    BD_VER=0.60.0; \
    curl -fsSL "https://github.com/steveyegge/beads/releases/download/v${BD_VER}/beads_${BD_VER}_linux_amd64.tar.gz" \
        -o /tmp/beads.tar.gz \
    && tar -xzf /tmp/beads.tar.gz -C /tmp \
    && mv /tmp/bd /usr/local/bin/bd \
    && chmod +x /usr/local/bin/bd \
    && rm -f /tmp/beads.tar.gz /tmp/bd 2>/dev/null; true

# Dolt — bd init auto-starts dolt as a subprocess; must be present in PATH
RUN set -eux; \
    DOLT_VER=$(curl -fsSL https://api.github.com/repos/dolthub/dolt/releases/latest \
        | grep '"tag_name"' | sed 's/.*"v\([^"]*\)".*/\1/'); \
    curl -fsSL "https://github.com/dolthub/dolt/releases/download/v${DOLT_VER}/dolt-linux-amd64.tar.gz" \
        -o /tmp/dolt.tar.gz \
    && mkdir -p /tmp/dolt-extract \
    && tar -xzf /tmp/dolt.tar.gz -C /tmp/dolt-extract \
    && find /tmp/dolt-extract -type f -name 'dolt' -exec mv {} /usr/local/bin/dolt \; \
    && chmod +x /usr/local/bin/dolt \
    && rm -rf /tmp/dolt.tar.gz /tmp/dolt-extract

# Copilot CLI — ACP server (copilot --acp --stdio)
RUN set -eux; \
    COPILOT_VER=$(curl -fsSL https://api.github.com/repos/github/copilot-cli/releases/latest \
        | grep '"tag_name"' | sed 's/.*"v\([^"]*\)".*/\1/'); \
    curl -fsSL "https://github.com/github/copilot-cli/releases/download/v${COPILOT_VER}/copilot-linux-x64.tar.gz" \
        -o /tmp/copilot.tar.gz \
    && mkdir -p /tmp/copilot-extract \
    && tar -xzf /tmp/copilot.tar.gz -C /tmp/copilot-extract \
    && find /tmp/copilot-extract -type f -name 'copilot' -exec mv {} /usr/local/bin/copilot \; \
    && chmod +x /usr/local/bin/copilot \
    && rm -rf /tmp/copilot.tar.gz /tmp/copilot-extract

# Vessel Driver — ACP client; reads ISSUE_ID, drives Copilot via JSON-RPC over stdio
COPY --from=builder /vessel-driver /usr/local/bin/vessel-driver
RUN chmod +x /usr/local/bin/vessel-driver

# GitHub CLI — `gh auth setup-git` wires git's credential helper so tokens
# never appear in remote URLs or log output
RUN set -eux; \
    GH_VER=$(curl -fsSL https://api.github.com/repos/cli/cli/releases/latest \
        | grep '"tag_name"' | sed 's/.*"v\([^"]*\)".*/\1/'); \
    curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VER}/gh_${GH_VER}_linux_amd64.tar.gz" \
        -o /tmp/gh.tar.gz \
    && mkdir -p /tmp/gh-extract \
    && tar -xzf /tmp/gh.tar.gz -C /tmp/gh-extract \
    && find /tmp/gh-extract -type f -name 'gh' -exec mv {} /usr/local/bin/gh \; \
    && chmod +x /usr/local/bin/gh \
    && rm -rf /tmp/gh.tar.gz /tmp/gh-extract

WORKDIR /app

# Entrypoint wrapper: translate DOLT_HOST/DOLT_PORT → BEADS_DOLT_SERVER_HOST/PORT
# so that every bd subcommand in the vessel (including those called by vessel-driver)
# finds the containerized Dolt on dolt:3306 instead of the config.yaml default.
# bd v0.60.0+ honours BEADS_DOLT_SERVER_HOST/PORT at startup.
RUN { \
      echo '#!/bin/sh'; \
      echo 'export BEADS_DOLT_SERVER_HOST="${DOLT_HOST:-dolt}"'; \
      echo 'export BEADS_DOLT_SERVER_PORT="${DOLT_PORT:-3306}"'; \
      echo 'exec /usr/local/bin/vessel-driver "$@"'; \
    } > /usr/local/bin/vessel-entrypoint.sh \
    && chmod +x /usr/local/bin/vessel-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/vessel-entrypoint.sh"]
