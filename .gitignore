
# Dolt database files (added by bd init)
.dolt/
*.db

# Compiled Windows binaries
*.exe

# Compiled Go binaries
/vessel-driver

# Local environment — contains secrets; never commit
.env

# Logs (local-only, can be large and not useful to track)
*.log

# IDE workspace files
legion.code-workspace
.legion/context/

# Vessel runtime files — written by pre-run.sh and vessel-driver at container runtime;
# must never be committed to the branch by post-run.sh's git add -A.
.legion/context.json
.legion/issue.json
result.json
